# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Supabase Postgres (pooled connection for the app, direct for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# NextAuth — database session strategy (FR-UM-11). Generate a secret with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# HMAC key for deriving default student passwords from student numbers (FR-UM-03).
# Distinct from NEXTAUTH_SECRET — different blast radius if leaked. Generate with:
#   openssl rand -base64 32
STUDENT_DEFAULT_PASSWORD_PEPPER=""

# Supabase Storage (Phase 2 — service-role only, never exposed to the client;
# no NEXT_PUBLIC_* variant should ever be added for this project).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Gemini API — text-embedding-004 (similarity) + 2.5 Flash (sentiment)
GEMINI_API_KEY=""

# Resend — transactional email
RESEND_API_KEY=""
# Sender on your verified Resend domain, e.g. IDSMS-CIS <reports@your-domain.edu>
RESEND_FROM_EMAIL=""

# Module 8 PDF generation — local dev only. Leave unset on Vercel/Linux, where
# @sparticuz/chromium supplies the browser. Windows examples:
#   C:\Program Files\Google\Chrome\Application\chrome.exe
#   C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
PUPPETEER_EXECUTABLE_PATH=

# FR-NT-05 daily notifications (deadline reminders, MOA expiry). Random 32+ chars.
# Vercel: set in the project env and Vercel Cron sends it automatically (vercel.json).
# Lab server (Phase 5): a host cron calls the same route daily at 08:00 Manila:
#   0 0 * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://<host>/api/cron/daily
CRON_SECRET=""
