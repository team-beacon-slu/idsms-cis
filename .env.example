# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Supabase Postgres (pooled connection for the app, direct for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# NextAuth — database session strategy (FR-UM-11). Generate a secret with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Gemini API — text-embedding-004 (similarity) + 2.5 Flash (sentiment)
GEMINI_API_KEY=""

# Resend — transactional email
RESEND_API_KEY=""
