# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Supabase Postgres (pooled connection for the app, direct for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Prisma 7 uses the pg driver: TLS is on (unverified, as with Prisma 6). Set disable for a local Postgres.
# PGSSLMODE=disable
# Database connections per app process (default 10, right for one long-running server).
# PG_POOL_MAX=10   (set 1 on Vercel: one connection per serverless instance)

# NextAuth — database session strategy (FR-UM-11). Generate a secret with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# HMAC key for deriving default student passwords from student numbers (FR-UM-03).
# Distinct from NEXTAUTH_SECRET — different blast radius if leaked. Generate with:
#   openssl rand -base64 32
STUDENT_DEFAULT_PASSWORD_PEPPER=""

# File storage. "supabase" (default, today) or "s3" (the lab server's MinIO, Phase 5).
STORAGE_DRIVER="supabase"

# Supabase Storage (Phase 2 — service-role only, never exposed to the client;
# no NEXT_PUBLIC_* variant should ever be added for this project).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# MinIO / S3 — only when STORAGE_DRIVER="s3". Inside deploy/docker-compose.yml the
# endpoint is http://minio:9000; use a MinIO service account, not the root user.
MINIO_ENDPOINT=""
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_REGION="us-east-1"

# Gemini API — text-embedding-004 (similarity) + 2.5 Flash (sentiment)
GEMINI_API_KEY=""
# Phase 4 AI (advisory only; feature stays off until enabled by a Super Admin).
# Google retires models: text-embedding-004 and gemini-2.5-flash are gone.
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_SENTIMENT_MODEL="gemini-3.5-flash-lite"  # measured 1-2 s; gemini-3.8-flash took 79 s+ on the free tier

# AI provider (ai-assist-plan R1). Unset = Gemini above. "openai" = any OpenAI-compatible
# server: Ollama on the lab server (http://ollama:11434/v1, no key), or for the beta Gemini's
# endpoint https://generativelanguage.googleapis.com/v1beta/openai with GEMINI's key as AI_API_KEY.
# AI_PROVIDER=openai
# AI_BASE_URL=
# AI_API_KEY=
# AI_EMBEDDING_MODEL=   (must return 768 dimensions)
# AI_CHAT_MODEL=

# Resend — transactional email
RESEND_API_KEY=""
# Sender on your verified Resend domain, e.g. IDSMS-CIS <reports@your-domain.edu>
RESEND_FROM_EMAIL=""

# Module 8 PDF generation — local dev only. Leave unset on Vercel/Linux, where
# @sparticuz/chromium supplies the browser. Windows examples:
#   C:\Program Files\Google\Chrome\Application\chrome.exe
#   C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
PUPPETEER_EXECUTABLE_PATH=

# FR-NT-05 daily notifications (deadline reminders, MOA expiry). Random 32+ chars.
# Vercel: set in the project env and Vercel Cron sends it automatically (vercel.json).
# Lab server (Phase 5): a host cron calls the same route daily at 08:00 Manila:
#   0 0 * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://<host>/api/cron/daily
CRON_SECRET=""

# --- Beta deployment only (remove at full rollout) ---
# "Sign in with your SLU Google account" (server + login button) and the beta notice.
BETA_GOOGLE_SIGNIN=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_BETA_NOTICE=false
NEXT_PUBLIC_BETA_FEEDBACK_URL=
