// IDSMS-CIS Prisma schema
// 18 tables per PRD.md v1.3 Database Schema section (16 domain tables + sessions/accounts
// added in v1.3 for NextAuth's database session strategy — see FR-UM-11).
//
// The `vector` extension and the audit_logs append-only RLS policy must be applied via
// the raw SQL migration in prisma/migrations_manual/ before this schema can be pushed.

generator client {
  provider = "prisma-client-js"
}

// Connection URLs live in prisma.config.ts (CLI) and src/lib/prisma.ts (app) since Prisma 7.
datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  DEPARTMENT_COORDINATOR
  FACULTY_ADVISER
  STUDENT_INTERN
}

enum Program {
  BSIT
  BSCS
  BMMA
}

enum WorkModality {
  ON_SITE
  WORK_FROM_HOME
  HYBRID
}

enum MoaStatus {
  DRAFTING
  PENDING
  FOR_HTE_REVIEW
  FOR_UNIVERSITY_REVIEW
  APPROVED_ACTIVE
  EXPIRING
  EXPIRED
  ARCHIVED
}

enum ChecklistRequirementType {
  MEDICAL_CERTIFICATE
  PSYCHOLOGICAL_CLEARANCE
  PARENT_CONSENT_UNDERTAKING
  COMPANY_REPLY_FORM
  DATA_PRIVACY_ORIENTATION
  INTERNSHIP_ORIENTATION
  GOVERNMENT_COMPANY_PERMIT
  WORK_PLAN
  MOA
}

enum ChecklistStatus {
  PENDING
  APPROVED
  RETURNED
}

enum WorkPlanStatus {
  SUBMITTED
  APPROVED
  RETURNED
}

enum DeviationType {
  ABSENCE
  OVERTIME
  UNDERTIME
}

enum RequestKind {
  ANTICIPATED
  EMERGENCY
}

enum ProofType {
  MEDICAL_CERTIFICATE
  PROOF_OF_LEAVE
  WRITTEN_NOTICE
}

enum ValidationStatus {
  PENDING
  VALIDATED
  REJECTED
}

enum WeeklyReportStatus {
  PENDING
  APPROVED
  RETURNED
  REGARDED
  DISREGARDED
}

enum SentimentLabel {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum DocumentType {
  ENDORSEMENT_LETTER
  WEEKLY_REPORT
  MONTHLY_REPORT
  FINAL_REPORT_COVER
  FINAL_TECHNICAL_REPORT
}

enum DocumentStatus {
  PENDING_DRAFT
  GENERATED
  FAILED
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationStatus {
  SENT
  PENDING
  FAILED
}

enum HolidayType {
  NATIONAL
  REGIONAL
}

// ── NextAuth (database session strategy — FR-UM-11) ────────────────────────

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// Deleting a row here is the enforcement mechanism for FR-UM-11 instant revocation.
model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ── Core domain tables ──────────────────────────────────────────────────

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique
  hashedPassword        String    @map("hashed_password")
  role                  Role
  isActive              Boolean   @default(true) @map("is_active")
  mustResetPassword     Boolean   @default(true) @map("must_reset_password")
  failedLoginAttempts   Int       @default(0) @map("failed_login_attempts")
  lockedUntil           DateTime? @map("locked_until")
  // FR-CK-05: null until the user agrees to the privacy notice; a new version asks again.
  privacyConsentAt      DateTime? @map("privacy_consent_at") @db.Timestamptz
  privacyConsentVersion String?   @map("privacy_consent_version")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  accounts               Account[]
  sessions               Session[]
  studentProfile         StudentProfile?
  facultyGroups          FacultyClassGroup[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  passwordResetTokens    PasswordResetToken[]
  reviewedChecklistItems PreDeploymentChecklistItem[] @relation("ChecklistReviewer")
  coordinatedWorkPlans   WorkPlan[]                   @relation("WorkPlanCoordinator")
  dataRequests           DataRequest[]                @relation("DataRequestRequester")
  fulfilledDataRequests  DataRequest[]                @relation("DataRequestFulfiller")

  @@map("users")
}

// FR-UM-10 (reset-password magic link, 1-hour expiry). Only the hash is stored —
// same rationale as hashedPassword: a DB leak must not hand out usable tokens.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model StudentProfile {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @unique @map("user_id") @db.Uuid
  studentNumber       String    @unique @map("student_number")
  program             Program
  classGroupId        String    @map("class_group_id") @db.Uuid
  semesterId          String    @map("semester_id") @db.Uuid
  companyId           String?   @map("company_id") @db.Uuid
  requiredHours       Int       @map("required_hours")
  renderedHours       Decimal   @default(0) @map("rendered_hours") @db.Decimal(6, 2)
  internshipFaceType  String?   @map("internship_face_type")
  internshipStartDate DateTime? @map("internship_start_date")
  // Per-deployment, not per-company (a company has no single "position title") —
  // FR-MOA-01 bundles this into "company registration" but it belongs here.
  positionTitle       String?   @map("position_title")
  // FR-DG-01 endorsement letter needs the student's legal name; the users
  // table only holds an email. Nullable — set from the profile page.
  fullName            String?   @map("full_name")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  user       User       @relation(fields: [userId], references: [id])
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id])
  semester   Semester   @relation(fields: [semesterId], references: [id])
  company    Company?   @relation(fields: [companyId], references: [id])

  checklistItems       PreDeploymentChecklistItem[]
  workPlans            WorkPlan[]
  deviationReports     DeviationReport[]
  conductRecords       ConductRecord[]
  deductionExceptions  DeductionException[]
  finalTechnicalReport FinalTechnicalReport?
  weeklyReports        WeeklyReport[]
  generatedDocuments   GeneratedDocument[]
  holidayOverrides     HolidayCalendarEntry[]

  // classGroupId/semesterId are pre-existing Phase 0 gaps (Postgres never
  // auto-indexes FK columns) left alone here; companyId and classGroupId are
  // fixed because Phase 2's own new queries (MOA-approval checklist sync,
  // the Faculty roster page) filter on them directly.
  @@index([companyId])
  @@index([classGroupId])
  @@map("student_profiles")
}

model ClassGroup {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  startDate DateTime  @map("start_date")
  endDate   DateTime  @map("end_date")
  program   Program
  classType String    @map("class_type")
  deletedAt DateTime? @map("deleted_at")

  students      StudentProfile[]
  facultyGroups FacultyClassGroup[]

  @@map("class_groups")
}

// NEW in PRD v1.2 — enables many-to-many faculty <-> class group.
model FacultyClassGroup {
  id           String @id @default(uuid()) @db.Uuid
  facultyId    String @map("faculty_id") @db.Uuid
  classGroupId String @map("class_group_id") @db.Uuid
  semesterId   String @map("semester_id") @db.Uuid

  faculty    User       @relation(fields: [facultyId], references: [id])
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id])
  semester   Semester   @relation(fields: [semesterId], references: [id])

  @@unique([facultyId, classGroupId, semesterId])
  @@map("faculty_class_groups")
}

model Semester {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  startDate    DateTime  @map("start_date")
  endDate      DateTime  @map("end_date")
  academicYear String    @map("academic_year")
  isActive     Boolean   @default(false) @map("is_active")
  archivedAt   DateTime? @map("archived_at")
  // Faculty-defined start of Week 1 for the term (weekly report numbering).
  weekOneStart DateTime? @map("week_one_start")

  students       StudentProfile[]
  facultyGroups  FacultyClassGroup[]
  holidayEntries HolidayCalendarEntry[]

  @@map("semesters")
}

model Company {
  id                 String       @id @default(uuid()) @db.Uuid
  name               String
  address            String
  workModality       WorkModality @map("work_modality")
  supervisorName     String       @map("supervisor_name")
  supervisorContact  String       @map("supervisor_contact")
  supervisorPosition String?      @map("supervisor_position") // FR-DG-01
  isVerified         Boolean      @default(false) @map("is_verified")
  deletedAt          DateTime?    @map("deleted_at")

  students   StudentProfile[]
  moaRecords MoaRecord[]

  @@map("companies")
}

model MoaRecord {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  // Exactly one of documentUrl/documentPath is set — enforced in the
  // validator (Zod .refine()), not a DB constraint, matching this project's
  // style of business rules living in the service/validator layer.
  documentUrl     String?   @map("document_url") // external Google Drive link (FR-MOA-03)
  documentPath    String?   @map("document_path") // internal Supabase Storage object path
  status          MoaStatus @default(DRAFTING)
  validFrom       DateTime  @map("valid_from")
  validTo         DateTime  @map("valid_to")
  programsCovered Program[] @map("programs_covered")
  archivedAt      DateTime? @map("archived_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("moa_records")
}

model PreDeploymentChecklistItem {
  id               String                   @id @default(uuid()) @db.Uuid
  studentProfileId String                   @map("student_profile_id") @db.Uuid
  requirementType  ChecklistRequirementType @map("requirement_type")
  status           ChecklistStatus          @default(PENDING)
  // Holds a Storage object path (resolved to a signed URL at read time), not
  // a fetchable URL — renamed from fileUrl since nothing wrote it before now.
  filePath         String?                  @map("file_path")
  reviewerId       String?                  @map("reviewer_id") @db.Uuid
  reviewDate       DateTime?                @map("review_date")
  comments         String?
  archivedAt       DateTime?                @map("archived_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])
  reviewer       User?          @relation("ChecklistReviewer", fields: [reviewerId], references: [id])

  @@unique([studentProfileId, requirementType])
  @@index([reviewerId])
  @@map("pre_deployment_checklist_items")
}

model WorkPlan {
  id                    String         @id @default(uuid()) @db.Uuid
  studentProfileId      String         @map("student_profile_id") @db.Uuid
  status                WorkPlanStatus @default(SUBMITTED)
  plannedTasks          Json           @map("planned_tasks")
  scheduleConfig        Json?          @map("schedule_config")
  scheduleChangeHistory Json           @default("[]") @map("schedule_change_history")
  approvalMetadata      Json?          @map("approval_metadata")
  coordinatorId         String?        @map("coordinator_id") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])
  coordinator    User?          @relation("WorkPlanCoordinator", fields: [coordinatorId], references: [id])

  @@index([studentProfileId])
  @@index([coordinatorId])
  @@map("work_plans")
}

model WeeklyReport {
  id                  String             @id @default(uuid()) @db.Uuid
  studentProfileId    String             @map("student_profile_id") @db.Uuid
  weekStart           DateTime           @map("week_start")
  weekEnd             DateTime           @map("week_end")
  totalHours          Decimal            @default(0) @map("total_hours") @db.Decimal(5, 2)
  runningTotal        Decimal            @default(0) @map("running_total") @db.Decimal(6, 2)
  remainingHours      Decimal            @default(0) @map("remaining_hours") @db.Decimal(6, 2)
  status              WeeklyReportStatus @default(PENDING)
  facultyAction       String?            @map("faculty_action")
  revisionHistory     Json               @default("[]") @map("revision_history")
  similarityScore     Decimal?           @map("similarity_score") @db.Decimal(4, 3)
  similarityFlag      Boolean            @default(false) @map("similarity_flag")
  sentimentLabel      SentimentLabel?    @map("sentiment_label")
  sentimentConfidence Decimal?           @map("sentiment_confidence") @db.Decimal(4, 3)
  sentimentReasoning  String?            @map("sentiment_reasoning") @db.Text // FR-AI-03 brief reasoning
  aiProcessedAt       DateTime?          @map("ai_processed_at")

  studentProfile StudentProfile     @relation(fields: [studentProfileId], references: [id])
  dailyEntries   DailyReportEntry[]

  @@unique([studentProfileId, weekStart])
  @@map("weekly_reports")
}

model DailyReportEntry {
  id               String   @id @default(uuid()) @db.Uuid
  weeklyReportId   String   @map("weekly_report_id") @db.Uuid
  reportDate       DateTime @map("report_date")
  attendanceStatus String   @map("attendance_status")
  scheduledHours   Decimal  @map("scheduled_hours") @db.Decimal(4, 2)
  actualHours      Decimal? @map("actual_hours") @db.Decimal(4, 2)
  accomplishments  String?  @db.Text
  toolsUsed        String?  @map("tools_used")
  // Phase 4 (adviser request): optional wall-clock times, "HH:MM" Manila.
  timeIn           String?  @map("time_in")
  timeOut          String?  @map("time_out")
  // Workstream L1: optional second ("afternoon") range, and the SLU-credited
  // hours computed at save time (null on legacy rows; read via entryCreditedHours).
  timeIn2          String?  @map("time_in_2")
  timeOut2         String?  @map("time_out_2")
  creditedHours    Decimal? @map("credited_hours") @db.Decimal(4, 2)
  // embeddingVector: pgvector column, added via raw SQL migration (see
  // prisma/migrations_manual/) — Prisma has no native `vector` type, so this
  // field is queried through $queryRaw in aiService.ts, not through the client.

  weeklyReport WeeklyReport @relation(fields: [weeklyReportId], references: [id])

  @@index([weeklyReportId])
  @@map("daily_report_entries")
}

model DeviationReport {
  id               String           @id @default(uuid()) @db.Uuid
  studentProfileId String           @map("student_profile_id") @db.Uuid
  date             DateTime
  deviationType    DeviationType    @map("deviation_type")
  reason           String
  proofUrl         String?          @map("proof_url")
  validationStatus ValidationStatus @default(PENDING) @map("validation_status")
  facultyId        String?          @map("faculty_id") @db.Uuid
  // Workstream L1: the deviation is now a leave / OT / UT request.
  requestKind      RequestKind?     @map("request_kind")
  endDate          DateTime?        @map("end_date")
  startTime        String?          @map("start_time")
  endTime          String?          @map("end_time")
  requestedMinutes Int?             @map("requested_minutes")
  proofType        ProofType?       @map("proof_type")
  reviewNote       String?          @map("review_note")
  submittedAt      DateTime?        @map("submitted_at") @db.Timestamptz(3)
  updatedAt        DateTime?        @map("updated_at") @db.Timestamptz(3)

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@index([studentProfileId, validationStatus])
  @@map("deviation_reports")
}

enum FinalReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

// Workstream H (PRD Module 7): one Final Technical Report per intern.
// sections / attachments are JSON so SLU's outline can change without a migration.
model FinalTechnicalReport {
  id               String            @id @default(uuid()) @db.Uuid
  studentProfileId String            @unique @map("student_profile_id") @db.Uuid
  status           FinalReportStatus @default(DRAFT)
  sections         Json              @default("{}")
  supervisorScore  Decimal?          @map("supervisor_score") @db.Decimal(5, 2)
  supervisorScale  Int?              @map("supervisor_scale")
  peerScore        Decimal?          @map("peer_score") @db.Decimal(5, 2)
  peerScale        Int?              @map("peer_scale")
  attachments      Json              @default("{}") // { key: { attached, confirmed } }
  reviewNote       String?           @map("review_note")
  submittedAt      DateTime?         @map("submitted_at") @db.Timestamptz(3)
  reviewedAt       DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  reviewedById     String?           @map("reviewed_by_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@map("final_technical_reports")
}

// Workstream L2: a warning, demerit, violation or suspension issued by staff.
// Never deleted, only revoked with a reason.
model ConductRecord {
  id               String    @id @default(uuid()) @db.Uuid
  studentProfileId String    @map("student_profile_id") @db.Uuid
  categoryKey      String    @map("category_key")
  weight           Int       @default(1) // a "First and Final" warning counts 2
  date             DateTime
  reason           String
  hoursDeducted    Decimal   @default(0) @map("hours_deducted") @db.Decimal(4, 2)
  issuedById       String    @map("issued_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById      String?   @map("revoked_by_id") @db.Uuid
  revokeReason     String?   @map("revoke_reason")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@index([studentProfileId])
  @@map("conduct_records")
}

// Workstream L2: staff excuse an automatic deduction item (late/missing WWR,
// unsupported UT/absence). Never deleted, only withdrawn.
model DeductionException {
  id               String    @id @default(uuid()) @db.Uuid
  studentProfileId String    @map("student_profile_id") @db.Uuid
  itemType         String    @map("item_type") // LATE_WWR | MISSING_WWR | UNSUPPORTED_UT
  itemKey          String    @map("item_key") // weeklyReportId, week start or YYYY-MM-DD
  reasonCode       String    @map("reason_code") // HTE_ATTESTED_DOCUMENTATION | BEYOND_INTERN_CONTROL
  note             String
  createdById      String    @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  withdrawnAt      DateTime? @map("withdrawn_at") @db.Timestamptz(3)
  withdrawnById    String?   @map("withdrawn_by_id") @db.Uuid

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@index([studentProfileId])
  @@map("deduction_exceptions")
}

model GeneratedDocument {
  id               String         @id @default(uuid()) @db.Uuid
  studentProfileId String         @map("student_profile_id") @db.Uuid
  documentType     DocumentType   @map("document_type")
  fileUrl          String?        @map("file_url")
  referenceCode    String?        @unique @map("reference_code")
  // Disambiguates which week/month a WEEKLY_REPORT or MONTHLY_REPORT row
  // represents (e.g. "2026-08-24" for a week-start, "2026-08" for a
  // calendar month). Null for ENDORSEMENT_LETTER/FINAL_REPORT_COVER.
  periodLabel      String?        @map("period_label")
  generatedAt      DateTime?      @map("generated_at")
  status           DocumentStatus @default(PENDING_DRAFT)

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@map("generated_documents")
}

model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  triggerType String              @map("trigger_type")
  channel     NotificationChannel
  status      NotificationStatus  @default(PENDING)
  payload     Json?
  sentAt      DateTime?           @map("sent_at")
  readAt      DateTime?           @map("read_at") @db.Timestamptz(3) // IN_APP only; null = unread

  user User @relation(fields: [userId], references: [id])

  // Unread badge + inbox. The IN_APP dedupe unique index is partial and on a
  // JSON expression, so it lives only in migrations_manual/006.
  @@index([userId, channel, readAt])
  @@map("notifications")
}

// Append-only: enforced by triggers in migrations_manual/007 (the app's postgres role bypasses RLS); RLS policies from 001 remain as defense in depth.
// Applied through raw SQL, not through Prisma — Prisma has no way to express "no UPDATE/DELETE".
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  ipAddress  String?  @map("ip_address")
  timestamp  DateTime @default(now())
  detail     Json?

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("audit_logs")
}

enum DataRequestStatus {
  OPEN
  FULFILLED
}

enum RetentionStatus {
  PENDING
  KEPT
  DELETED
}

enum RetentionSource {
  CHECKLIST
  DEVIATION_PROOF
  GENERATED_DOCUMENT
}

model DataRequest {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  status      DataRequestStatus @default(OPEN)
  requestedAt DateTime          @default(now()) @map("requested_at") @db.Timestamptz(3)
  dueAt       DateTime          @map("due_at") @db.Timestamptz(3)
  fulfilledAt DateTime?         @map("fulfilled_at") @db.Timestamptz(3)
  fulfilledBy String?           @map("fulfilled_by") @db.Uuid

  user      User  @relation("DataRequestRequester", fields: [userId], references: [id])
  fulfiller User? @relation("DataRequestFulfiller", fields: [fulfilledBy], references: [id])

  @@index([status, dueAt])
  @@index([userId])
  @@map("data_requests")
}

model RetentionFlag {
  id               String          @id @default(uuid()) @db.Uuid
  bucket           String
  objectPath       String          @map("object_path")
  sourceType       RetentionSource @map("source_type")
  sourceId         String          @map("source_id") @db.Uuid
  studentProfileId String          @map("student_profile_id") @db.Uuid
  semesterEndDate  DateTime        @map("semester_end_date")
  flaggedAt        DateTime        @default(now()) @map("flagged_at") @db.Timestamptz(3)
  status           RetentionStatus @default(PENDING)
  reviewedAt       DateTime?       @map("reviewed_at") @db.Timestamptz(3)
  reviewedBy       String?         @map("reviewed_by") @db.Uuid

  @@unique([sourceType, sourceId])
  @@index([status])
  @@map("retention_flags")
}

model HolidayCalendarEntry {
  id               String      @id @default(uuid()) @db.Uuid
  date             DateTime
  name             String
  holidayType      HolidayType @map("holiday_type")
  semesterId       String?     @map("semester_id") @db.Uuid
  studentProfileId String?     @map("student_profile_id") @db.Uuid // nullable — company-specific override

  semester       Semester?       @relation(fields: [semesterId], references: [id])
  studentProfile StudentProfile? @relation(fields: [studentProfileId], references: [id])

  @@map("holiday_calendar")
}

model SystemConfig {
  id          String   @id @default(uuid()) @db.Uuid
  configKey   String   @unique @map("config_key")
  configValue Json     @map("config_value")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by") @db.Uuid

  @@map("system_config")
}
